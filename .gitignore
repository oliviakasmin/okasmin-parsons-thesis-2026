data/raw/
data/derived/
data/published/
pipeline/outputs/
test_assets/


# ─────────────────────────────────────────────
# Ignore ALL json by default
# ─────────────────────────────────────────────
*.json


# Re-allow required JSON/config files
!object_ids.json
!objects.json
!reject_object_ids.json
!api_errors_object_ids.json
!manual_reject_object_ids.json
!fetch_data/data/
!fetch_data/data/objects.json
!fetch_data/data/manual_reject_object_ids.json
