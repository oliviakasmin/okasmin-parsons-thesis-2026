!test_assets/clusters.json
!test_assets/most_interesting_matches.json
!test_assets/manual_interesting_ones.json
!test_assets/outline_contours.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!.prettierrc.json
!format_data/date/timeline_buckets.json
!format_data/color/new/manual_color_groups.json
!format_data/color/new/manual_representative_colors.json
!format_data/color/new/new_color_groups.json
!format_data/generated/shape_neighbors_euclidean.json
!format_data/generated/color/object_color_kmeans_exclude_manual_cluster_ui_order.json
!format_data/use_groups/representative.json
!format_data/use_groups/use_group_object_order.json

# ─────────────────────────────────────────────
# Ignore ALL images by default
# ─────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.webp
*.tif
*.tiff
*.bmp
*.svg

# Keep some images
!preview.png

# ─────────────────────────────────────────────
# Re-allow ALL app public assets
# ─────────────────────────────────────────────
!app/
!app/public/
!app/public/**

